{
  "manifest_version": 3,
  "name": "Navorika Tools",
  "version": "1.0.0",
  "description": "Open Navorika's practical image, CSS, PDF, and CAD tools from your Chrome toolbar.",
  "homepage_url": "https://navorika.com/",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "action": {
    "default_title": "Navorika Tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
